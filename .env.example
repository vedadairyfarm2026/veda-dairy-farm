# The confirmed main domain; this is also the default in config/seo.ts.
NEXT_PUBLIC_SITE_URL=https://www.vedadairyfarm.com

# Set false on preview/staging deployments, even if a domain is configured.
SEO_INDEXING_ENABLED=true

# Optional: the content value of Google's HTML verification meta tag.
GOOGLE_SITE_VERIFICATION=

# These confirmed details are also defaults in config/site.ts.
NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=Ambheta Village, Olpad Taluka, Surat District
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=395005
# Optional: link to the verified Google Maps listing, once available.
NEXT_PUBLIC_GOOGLE_MAPS_URL=
# Optional: the "Ask for reviews" link copied from your Google Business Profile.
# An honest-review invitation appears only when this real link is supplied.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
